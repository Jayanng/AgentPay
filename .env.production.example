# ==============================================
# BACKEND — Server
# ==============================================
PORT=3001
NODE_ENV=production

# Backend URL
APP_URL=http://YOUR_VM_IP

# Frontend URL (CORS origin)
FRONTEND_URL=http://YOUR_VM_IP

# ==============================================
# BACKEND — MongoDB
# ==============================================
MONGODB_URI=mongodb://YOUR_MONGO_HOST:27017/agentpay

# ==============================================
# BACKEND — JWT
# ==============================================
JWT_SECRET=CHANGE_ME_RANDOM_SECRET

# ==============================================
# COBO AGENTIC WALLET (CAW) — PRIMARY WALLET
# ==============================================
# CAW is the primary wallet for Agent-Native Payments.
# All fund operations route through CAW's API with
# automatic permission policy evaluation.
#
# Get credentials:
#   caw onboard --wait
#   caw wallet current --show-api-key

CAW_API_KEY=your-caw-api-key
CAW_WALLET_ID=your-caw-wallet-uuid
CAW_API_URL=https://api.agenticwallet.cobo.com
CAW_CHAIN_ID=SETH
CAW_TOKEN_ID=SETH_USDC

# ==============================================
# CHAIN CONFIGURATION
# ==============================================
X402_CHAIN=sepolia
X402_CURRENCY=USDC

# Fallback: Viem wallet (only needed without CAW)
# WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# X402_RECIPIENT_ADDRESS=0xYOUR_RECIPIENT_ADDRESS

# ==============================================
# AGENT — MCP Client / AI Agent
# ==============================================
AGENTPAY_SERVER=http://localhost:3001
MAX_AUTO_PAYMENT=10.00

# LLM Provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# ==============================================
# FRONTEND — Build args
# ==============================================
NEXT_PUBLIC_API_URL=http://YOUR_VM_IP
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
NEXT_PUBLIC_X402_CHAIN=sepolia
NEXT_PUBLIC_X402_CURRENCY=USDC
